<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CargoDeckPriceCapture</AssemblyName>
    <RootNamespace>CargoDeckScanner</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.7.2</Version>
    <Product>Cargo Deck Price Capture</Product>
    <Company>Cargo Deck</Company>
    <Description>Liest Star Citizen Handelsterminals und schickt die Preise an Cargo Deck</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- echte Kulturen, sonst stürzt WinForms beim Wechsel der Tastatursprache ab. Gerechnet wird trotzdem invariant, siehe Program.Main -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
    <!-- Texterkennung (PaddleOCR). Gesucht wird nach Namen, egal in welchem Ordner die Dateien liegen -->
    <EmbeddedResource Include="**\det.onnx" Exclude="bin\**;obj\**;out\**;pkg\**" LogicalName="ocr.det.onnx" />
    <EmbeddedResource Include="**\rec.onnx" Exclude="bin\**;obj\**;out\**;pkg\**" LogicalName="ocr.rec.onnx" />
    <EmbeddedResource Include="**\dict.txt" Exclude="bin\**;obj\**;out\**;pkg\**;linux\**" LogicalName="ocr.dict.txt" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

</Project>
